<resources>

    <style name="QsTileIconShapeDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowElevation">4dp</item>
    </style>

    <!--
        Same base as [QsTileIconShapeDialogTheme] (blur works). Keep windowIsFloating true:
        for API 31+, LayoutParams#blurBehindRadius and some blur paths are a no-op on true
        fullscreen (non-floating) windows, so a MATCH_PARENT *floating* dialog is used in code
        to fill the screen and still get blur.
    -->
    <style name="AboutEasterEggDialogTheme" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

</resources>
