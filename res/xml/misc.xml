<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/misc_title" >

    <PreferenceCategory
        android:title="@string/security_category_title">

        <org.derpfest.support.preferences.GlobalSettingSwitchPreference
            android:key="window_ignore_secure"
            android:title="@string/ignore_window_secure_title"
            android:summary="@string/ignore_window_secure_summary"
            android:defaultValue="false" />

        <org.derpfest.support.preferences.GlobalSettingSwitchPreference
            android:key="hide_screen_capture_status"
            android:title="@string/hide_screen_capture_status_title"
            android:summary="@string/hide_screen_capture_status_summary"
            android:defaultValue="false" />

        <Preference
            android:key="applocker_sandbox_settings"
            android:title="@string/applocker_sandbox_title"
            android:summary="@string/applocker_sandbox_summary">
            <intent
                android:action="android.intent.action.MAIN"
                android:targetPackage="com.android.axion.sandbox"
                android:targetClass="com.android.axion.sandbox.MainActivity" />
        </Preference>

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/dashboard_category_title">

        <org.derpfest.support.preferences.SystemSettingIntListPreference
            android:key="theming_settings_dashboard_icons"
            android:title="@string/theming_settings_dashboard_icons_title"
            android:entries="@array/theming_settings_dashboard_icons_entries"
            android:entryValues="@array/theming_settings_dashboard_icons_values"
            android:defaultValue="0" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/effects_category_title">

        <org.derpfest.support.preferences.SystemSettingSeekBarPreference
            android:key="blur_intensity"
            android:title="@string/blur_intensity_title"
            android:summary="@string/blur_intensity_summary"
            android:max="200"
            settings:min="0"
            android:defaultValue="100"
            settings:units="%" />

    </PreferenceCategory>

</PreferenceScreen>
