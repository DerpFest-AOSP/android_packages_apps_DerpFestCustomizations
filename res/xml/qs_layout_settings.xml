<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/qs_layout_settings_title" >

    <PreferenceCategory
        android:key="qs_layout_category"
        android:title="@string/qs_layout_category_title"
        android:summary="@string/qs_layout_category_summary" >

        <org.derpfest.support.preferences.ProperSeekBarPreference
            android:key="qs_layout_columns"
            android:title="@string/qs_layout_columns_title"
            android:summary="@string/qs_layout_columns_summary"
            android:defaultValue="4"
            android:max="6"
            settings:min="2"
            settings:interval="1"
            settings:units="@string/qs_layout_columns_units" />

        <org.derpfest.support.preferences.ProperSeekBarPreference
            android:key="qs_layout_rows"
            android:title="@string/qs_layout_rows_title"
            android:summary="@string/qs_layout_rows_summary"
            android:defaultValue="4"
            android:max="7"
            settings:min="1"
            settings:interval="1"
            settings:units="@string/qs_layout_rows_units" />

        <org.derpfest.support.preferences.ProperSeekBarPreference
            android:key="qs_layout_columns_landscape"
            android:title="@string/qs_layout_columns_landscape_title"
            android:summary="@string/qs_layout_columns_landscape_summary"
            android:defaultValue="6"
            android:max="6"
            settings:min="2"
            settings:interval="1"
            settings:units="@string/qs_layout_columns_landscape_units" />

        <org.derpfest.support.preferences.ProperSeekBarPreference
            android:key="qs_layout_rows_landscape"
            android:title="@string/qs_layout_rows_landscape_title"
            android:summary="@string/qs_layout_rows_landscape_summary"
            android:defaultValue="2"
            android:max="7"
            settings:min="1"
            settings:interval="1"
            settings:units="@string/qs_layout_rows_landscape_units" />

        <org.derpfest.support.preferences.SystemSettingSwitchPreference
            android:key="qs_media_respect_halving"
            android:title="@string/qs_media_respect_halving_title"
            android:summary="@string/qs_media_respect_halving_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="qqs_layout_category"
        android:title="@string/qqs_layout_category_title"
        android:summary="@string/qqs_layout_category_summary" >


        <org.derpfest.support.preferences.ProperSeekBarPreference
            android:key="qqs_layout_rows"
            android:title="@string/qqs_layout_rows_title"
            android:summary="@string/qqs_layout_rows_summary"
            android:defaultValue="2"
            android:max="4"
            settings:min="1"
            settings:interval="1"
            settings:units="@string/qqs_layout_rows_units" />

        <org.derpfest.support.preferences.ProperSeekBarPreference
            android:key="qqs_layout_rows_landscape"
            android:title="@string/qqs_layout_rows_landscape_title"
            android:summary="@string/qqs_layout_rows_landscape_summary"
            android:defaultValue="1"
            android:max="4"
            settings:min="1"
            settings:interval="1"
            settings:units="@string/qqs_layout_rows_landscape_units" />

    </PreferenceCategory>

</PreferenceScreen>
