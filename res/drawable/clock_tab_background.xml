<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Same fill as Apply FAB; inset keeps rounded corners inside the tab view when the strip
         overscrolls or clips at the card edge (otherwise the pill reads as a square cut). -->
    <item android:state_selected="true">
        <inset
            android:insetLeft="3dp"
            android:insetTop="2dp"
            android:insetRight="3dp"
            android:insetBottom="2dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/settingslib_btn_colored_background_material" />
                <corners android:radius="22dp" />
            </shape>
        </inset>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
