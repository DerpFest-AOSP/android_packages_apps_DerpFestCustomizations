<org.derpfest.customizations.widget.SquareFrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/settingslib_expressive_space_extrasmall2"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:id="@+id/qs_tile_icon_shape_tile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/style_picker_tile_background"
        android:duplicateParentState="true"
        android:clickable="false"
        android:focusable="false"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/qs_tile_icon_shape_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:padding="18dp"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:duplicateParentState="true"
            android:importantForAccessibility="no" />
    </FrameLayout>
</org.derpfest.customizations.widget.SquareFrameLayout>
